{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spellcraft Script",
  "scopeName": "source.spellcraft-script",
  "patterns": [
    { "include": "#comments" },
    { "include": "#function-definition" },
    { "include": "#variable-declaration" },
    { "include": "#step" },
    { "include": "#expression" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spellcraft-script",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.spellcraft-script",
          "match": "#.*$"
        }
      ]
    },
    "function-definition": {
      "begin": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "storage.type.function.spellcraft-script" },
        "2": { "name": "entity.name.function.spellcraft-script" },
        "3": { "name": "punctuation.definition.parameters.begin.spellcraft-script" }
      },
      "end": "(\\))\\s*(?:(:)([^/#\\n]*))?",
      "endCaptures": {
        "1": { "name": "punctuation.definition.parameters.end.spellcraft-script" },
        "2": { "name": "punctuation.separator.type.spellcraft-script" },
        "3": { "patterns": [{ "include": "#type" }, { "include": "#punctuation" }] }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[\\s*\\d+\\s*\\])?)",
          "captures": {
            "1": { "name": "variable.parameter.spellcraft-script" },
            "2": { "name": "punctuation.separator.type.spellcraft-script" },
            "3": { "patterns": [{ "include": "#type" }] }
          }
        },
        { "include": "#punctuation" }
      ]
    },
    "variable-declaration": {
      "match": "\\b(global|scene|local)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[\\s*\\d+\\s*\\])?)",
      "captures": {
        "1": { "name": "storage.modifier.spellcraft-script" },
        "2": { "name": "variable.other.declaration.spellcraft-script" },
        "3": { "name": "punctuation.separator.type.spellcraft-script" },
        "4": { "patterns": [{ "include": "#type" }] }
      }
    },
    "type": {
      "patterns": [
        {
          "name": "storage.type.primitive.spellcraft-script",
          "match": "\\b(bool|i8|i16|i32|float|char|str)\\b"
        },
        {
          "name": "support.type.spellcraft-script",
          "match": "\\b(entity_id|entity_spawner)\\b"
        },
        {
          "name": "entity.name.type.spellcraft-script",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.spellcraft-script",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "punctuation.definition.array.spellcraft-script",
          "match": "[\\[\\]]"
        }
      ]
    },
    "step": {
      "comment": "A cutscene step: an identifier at the start of a statement that is not an assignment, e.g. `say \"hi\";` or `pause;`",
      "match": "(?:^|(?<=;))\\s*(?!(?:if|elif|else|then|end|func|return|local|global|scene|and|or|not|true|false)\\b)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;|\\s+(?!==|=|,|and\\b|or\\b|then\\b)[A-Za-z0-9_\"(.\\-])",
      "captures": {
        "1": { "name": "entity.name.function.step.spellcraft-script" }
      }
    },
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#keywords" },
        { "include": "#numbers" },
        { "include": "#function-call" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#identifier" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spellcraft-script",
          "match": "\\b(if|then|elif|else|end|return)\\b"
        },
        {
          "name": "storage.type.function.spellcraft-script",
          "match": "\\bfunc\\b"
        },
        {
          "name": "storage.modifier.spellcraft-script",
          "match": "\\b(global|scene|local)\\b"
        },
        {
          "name": "keyword.operator.logical.spellcraft-script",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.spellcraft-script",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.spellcraft-script",
          "match": "(?<![A-Za-z0-9_])(\\d+\\.\\d*|\\.\\d+)"
        },
        {
          "name": "constant.numeric.integer.spellcraft-script",
          "match": "(?<![A-Za-z0-9_])\\d+\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.spellcraft-script" }
      }
    },
    "constants": {
      "name": "constant.other.enum.spellcraft-script",
      "match": "\\b[A-Z][A-Z0-9_]*\\b"
    },
    "identifier": {
      "name": "variable.other.spellcraft-script",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.spellcraft-script",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.spellcraft-script",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.spellcraft-script",
          "match": "[+\\-*/]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.spellcraft-script", "match": ";" },
        { "name": "punctuation.separator.comma.spellcraft-script", "match": "," },
        { "name": "punctuation.separator.type.spellcraft-script", "match": ":" },
        { "name": "punctuation.brackets.round.spellcraft-script", "match": "[()]" },
        { "name": "punctuation.brackets.square.spellcraft-script", "match": "[\\[\\]]" }
      ]
    },
    "string": {
      "name": "string.quoted.double.spellcraft-script",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.spellcraft-script" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.spellcraft-script" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.spellcraft-script",
          "match": "\\\\\""
        },
        { "include": "#string-interpolation" }
      ]
    },
    "string-interpolation": {
      "name": "meta.interpolation.spellcraft-script",
      "contentName": "meta.embedded.expression.spellcraft-script",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.spellcraft-script" }
      },
      "end": "(?:(:)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*)?(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.separator.format.spellcraft-script" },
        "2": { "name": "storage.modifier.format.spellcraft-script" },
        "3": { "name": "punctuation.section.interpolation.end.spellcraft-script" }
      },
      "patterns": [
        { "include": "#string" },
        { "include": "#keywords" },
        { "include": "#numbers" },
        { "include": "#function-call" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#identifier" },
        { "name": "punctuation.separator.comma.spellcraft-script", "match": "," },
        { "name": "punctuation.brackets.round.spellcraft-script", "match": "[()]" }
      ]
    }
  }
}
